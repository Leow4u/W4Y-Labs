# --- raiz da plataforma ---
node_modules/
.env
.env.local
*.log
.secrets/
*.json.key

# O wayne-agent/ tem o próprio .gitignore (herdado do upstream)
graphify-out/

# Experimentos — não são caminho oficial do produto (ver docs/PRODUTO.md).
# Ficam em disco para consulta, fora do git para não poluir `git status`.
model-experience-poc/
w4y-studio/

# Saída de build
dist/
.next/
out/

# App única — artefactos (não commitar)
**/web_dist/
**/app_dist/
wayne-agent/apps/work4you/release/
wayne-agent/apps/work4you/release-build-*/
# Numbered release dirs (release-1093/, release-1095/) are build output too —
# 478MB each and previously not covered by the release-build-* pattern.
wayne-agent/apps/work4you/release-[0-9]*/
wayne-agent/apps/desktop/release-build-*/
platform/infra/.engine-signing/
platform/wayne-fly/wayne-engine-*.zip

# Local scratch from infra debugging. _user-query-rows.txt in particular held
# real user emails and tenant ids — operational data, never repo content.
platform/infra/_user-query*
platform/infra/_sv-logs.json

# Agent worktree metadata, local to one machine.
.claude/worktrees/
