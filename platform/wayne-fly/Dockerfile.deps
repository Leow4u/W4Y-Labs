# Overlay de DEPENDÊNCIAS de skills — Ondas B+C+D + pip-nicho da auditoria de
# operabilidade (docs/SKILLS-AUDITORIA.md). Camada única sobre a imagem base
# fly; a UI (Dockerfile.ui) é construída EM CIMA desta
# (--build-arg BASE_IMAGE=registry.fly.io/wayne-w4y:<esta imagem>).
#
# Onda B — pips leves no venv do agente (/opt/wayne/.venv):
#   openpyxl -> excel · youtube-transcript-api -> youtube · pymupdf(+4llm) -> ocr
#   markitdown[pptx] -> powerpoint (leitura; inclui python-pptx)
# Onda C — LibreOffice headless enxuto + poppler:
#   soffice -> powerpoint completo (criar + QA visual + miniaturas)
# Onda D — LaTeX (texlive subset) + pips científicos:
#   pdflatex/latexmk/biber + numpy/scipy/matplotlib/SciencePlots/habanero/
#   semanticscholar -> research-paper-writing (compila PDF de artigo)
# pip-nicho:
#   numpy/scipy -> ascii-video · jupyterlab -> jupyter-live-kernel
ARG BASE_IMAGE=registry.fly.io/wayne-w4y:fly36
FROM ${BASE_IMAGE}

USER root

# apt: LibreOffice enxuto + poppler (Onda C) + LaTeX subset (Onda D).
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        libreoffice-impress \
        libreoffice-calc \
        libreoffice-writer \
        poppler-utils \
        fonts-liberation \
        texlive-latex-recommended \
        texlive-latex-extra \
        texlive-fonts-recommended \
        texlive-science \
        texlive-bibtex-extra \
        biber \
        latexmk \
        dvisvgm && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

# pip (uv) direto no venv do agente — Ondas B+D + nicho.
RUN uv pip install --python /opt/wayne/.venv/bin/python3 \
        openpyxl \
        youtube-transcript-api \
        pymupdf \
        pymupdf4llm \
        "markitdown[pptx]" \
        numpy \
        scipy \
        matplotlib \
        SciencePlots \
        habanero \
        semanticscholar \
        jupyterlab

# Smoke checks de build: falha se algo não instalou.
RUN soffice --version && \
    pdftoppm -v 2>&1 | head -1 && \
    pdflatex --version | head -1 && \
    latexmk --version | head -1 && \
    /opt/wayne/.venv/bin/python3 -c "import openpyxl, fitz, pptx, youtube_transcript_api, numpy, scipy, matplotlib, jupyterlab; print('py-deps OK')"
