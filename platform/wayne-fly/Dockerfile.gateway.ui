# Overlay FINO de UI + backend do gateway — sobre a imagem fly pronta, sem
# rebuild da base de 3.7GB (mesmo padrão do Dockerfile.chat, mas pra
# tui_gateway/server.py em vez de work4you_cli/web_server.py). Usado quando um
# fix precisa tocar em código Python do gateway (RPCs) além do SPA.
#
# GOTCHA (aprendido ao vivo): um hot-patch via SSH direto no container NÃO
# sobrevive — /opt/wayne vem da camada da IMAGEM, não do volume persistente
# (/opt/data). Matar o processo do gateway (kill -TERM) fez o supervisor do
# Fly reciclar a MÁQUINA inteira, remontando a imagem original e apagando o
# patch. A única forma de fixar de verdade é assar no overlay e dar deploy.
#
# Contexto de build = wayne-agent/ (onde vivem app_dist e tui_gateway/).
ARG BASE_IMAGE=registry.fly.io/wayne-w4y:fly2
FROM ${BASE_IMAGE}
RUN rm -rf /opt/work4you/work4you_cli/web_dist /opt/work4you/work4you_cli/app_dist
COPY work4you_cli/app_dist /opt/work4you/work4you_cli/app_dist
COPY tui_gateway/server.py /opt/wayne/tui_gateway/server.py
