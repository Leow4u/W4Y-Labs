# Overlay FINO da Curadoria do Chat (Etapa A) — sobre a imagem fly pronta, sem
# rebuild da base de 3.7GB. Troca 3 coisas:
#   1) o SPA do dashboard  (app_dist)      — ChatPage cola o terminal no tema claro
#   2) o bundle do TUI     (ui-tui/dist)   — esbuild AUTO-CONTIDO: banner/status
#      escondidos + pele preto-no-branco + placeholder "Escreva uma mensagem…"
#   3) work4you_cli/web_server.py          — ponte WAYNE_TUI_LANG (i18n do placeholder)
#
# Contexto de build = wayne-agent/ (onde vivem app_dist, ui-tui/dist, work4you_cli).
# `FROM <base>` HERDA o ENTRYPOINT /init-fly da base — não precisa reaplicar init-fly.
# NB: o `.dockerignore` do contexto wayne-agent/ exclui `ui-tui/dist/` (a base o
# compila DENTRO do container). Por isso o dist entra por um CONTEXTO NOMEADO
# (`--build-context uituidist=wayne-agent/ui-tui/dist`), que não é filtrado pelo
# dockerignore do contexto principal. app_dist e web_server.py vêm do contexto normal.
ARG BASE_IMAGE=registry.fly.io/wayne-w4y:fly2
FROM ${BASE_IMAGE}
RUN rm -rf /opt/work4you/work4you_cli/web_dist /opt/work4you/work4you_cli/app_dist
COPY work4you_cli/app_dist /opt/work4you/work4you_cli/app_dist
COPY --from=uituidist . /opt/wayne/ui-tui/dist
COPY work4you_cli/web_server.py /opt/work4you/work4you_cli/web_server.py
